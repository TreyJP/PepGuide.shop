# Only set true for local UI work without Firebase. Production must stay false/unset.
NEXT_PUBLIC_USE_MOCK_SERVICES=false

# Comma-separated emails that can open /admin
NEXT_PUBLIC_ADMIN_EMAILS=

# Firebase web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OpenAI — server only. Do NOT prefix with NEXT_PUBLIC_
OPENAI_API_KEY=

# App URL used for Stripe redirects (production: https://www.pepguide.shop)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — PepGuide Pro ($20/mo)
# 1. Create a Stripe account → Developers → API keys → copy Secret key (sk_test_… / sk_live_…)
# 2. Optional: Products → PepGuide Pro → $20/month recurring → copy Price ID (price_…)
# 3. Developers → Webhooks → Add endpoint:
#      Production: https://www.pepguide.shop/api/billing/webhook
#      Local: stripe listen --forward-to localhost:3000/api/billing/webhook
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# 4. Copy webhook signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET
# 5. Settings → Billing → Customer portal → enable cancel / payment method updates
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: existing Stripe Price ID for the $20/mo subscription.
# If empty, checkout creates an inline $20/mo price.
STRIPE_PRICE_ID=

# Pro explainer video shown when a locked Pro feature opens the subscribe modal.
# YouTube (watch/shorts), Vimeo, or a public file path e.g. /pro/explainer.mp4
NEXT_PUBLIC_PRO_EXPLAINER_VIDEO_URL=
# Optional poster for direct mp4/webm sources
NEXT_PUBLIC_PRO_EXPLAINER_VIDEO_POSTER=

# Firebase Admin — required for checkout auth + unlocking Pro after payment
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
