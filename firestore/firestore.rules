rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAllowlistedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email is string
        && request.auth.token.email.lower()
          in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isAdmin() {
      return isAdminClaim() || isAllowlistedAdmin();
    }

    // Pro is enforced in the app UI. Rules allow any signed-in member so
    // env/allowlist/claim admin mismatches don't brick Forum reads.
    function canUseProCommunity() {
      return isSignedIn();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'displayName',
          'email',
          'createdAt',
          'onboardingCompleted',
          'subscriptionTier',
          'accountStatus'
        ])
        && request.resource.data.subscriptionTier == 'free'
        && request.resource.data.accountStatus == 'active'
        && (
          !('referredByAffiliateId' in request.resource.data)
          || request.resource.data.referredByAffiliateId == null
          || (
            request.resource.data.referredByCode is string
            && exists(/databases/$(database)/documents/referralAffiliates/$(request.resource.data.referredByAffiliateId))
            && get(/databases/$(database)/documents/referralAffiliates/$(request.resource.data.referredByAffiliateId)).data.active == true
            && get(/databases/$(database)/documents/referralAffiliates/$(request.resource.data.referredByAffiliateId)).data.code
              == request.resource.data.referredByCode
          )
        );

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'subscriptionTier',
            'accountStatus',
            'chatBlockedUntil',
            'abuseStrikeCount',
            'abuseWindowStartedAt',
            'lastAbuseAt',
            'referredByCode',
            'referredByAffiliateId'
          ]);

      allow delete: if isOwner(userId) || isAdmin();

      match /chats/{chatId} {
        // Owner can list all chats. Anyone with the chat link can get one chat
        // when a sharedChatRefs/{chatId} pointer exists (share-by-link).
        allow get: if isOwner(userId)
          || (
            exists(/databases/$(database)/documents/sharedChatRefs/$(chatId))
            && get(/databases/$(database)/documents/sharedChatRefs/$(chatId)).data.ownerUid
              == userId
          );
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);

        match /messages/{messageId} {
          // Temporary: allow client-written assistant messages until
          // Cloud Functions own the AI response write path.
          allow read: if isOwner(userId)
            || (
              exists(/databases/$(database)/documents/sharedChatRefs/$(chatId))
              && get(/databases/$(database)/documents/sharedChatRefs/$(chatId)).data.ownerUid
                == userId
            );
          allow write: if isOwner(userId);
        }
      }

      match /savedResearch/{savedItemId} {
        allow read, write: if isOwner(userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /cycleItems/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Share-by-link pointers: /chat/{chatId} → ownerUid (unguessable ids).
    match /sharedChatRefs/{chatId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid']);
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /peptides/{peptideId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /affiliatePartners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Signup referral affiliates (codes + commission %). Public read so
    // codes can be validated at signup and `/r/CODE` clicks can resolve.
    // New seats are admin-provisioned. Self-enroll create kept for legacy
    // docs only. Click increments are public (tracked share links).
    match /referralAffiliates/{affiliateId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          isSignedIn()
          && affiliateId == request.auth.uid
          && request.resource.data.linkedUserId == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.selfEnrolled == true
          && request.resource.data.firstOrderCommissionPercent == 50
          && request.resource.data.recurringCommissionPercent == 20
          && request.resource.data.commissionPercent == 50
          && request.resource.data.referralCount == 0
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 3
          && request.resource.data.code.size() <= 32
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
        );

      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['referralCount', 'updatedAt'])
          && request.resource.data.referralCount is int
          && request.resource.data.referralCount == resource.data.referralCount + 1
        )
        || (
          // Public click tracking for `/r/CODE` share links.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clickCount', 'updatedAt'])
          && request.resource.data.clickCount is int
          && request.resource.data.clickCount
            == resource.data.get('clickCount', 0) + 1
        )
        || (
          // Owner may update display name / preferred code only.
          isSignedIn()
          && resource.data.linkedUserId == request.auth.uid
          && request.resource.data.linkedUserId == resource.data.linkedUserId
          && request.resource.data.firstOrderCommissionPercent
            == resource.data.firstOrderCommissionPercent
          && request.resource.data.recurringCommissionPercent
            == resource.data.recurringCommissionPercent
          && request.resource.data.commissionPercent
            == resource.data.commissionPercent
          && request.resource.data.referralCount == resource.data.referralCount
          && request.resource.data.get('clickCount', 0)
            == resource.data.get('clickCount', 0)
          && request.resource.data.active == resource.data.active
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'code', 'updatedAt'])
        );
    }

    // Tracked referral link clicks from socials / link trees.
    match /referralClicks/{clickId} {
      allow create: if request.resource.data.keys()
          .hasAll(['affiliateId', 'code', 'createdAt'])
        && request.resource.data.affiliateId is string
        && request.resource.data.affiliateId.size() > 0
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 3
        && request.resource.data.code.size() <= 32
        && request.resource.data.createdAt is string
        && (!('userAgent' in request.resource.data)
          || request.resource.data.userAgent == null
          || (request.resource.data.userAgent is string
            && request.resource.data.userAgent.size() <= 300))
        && (!('referrer' in request.resource.data)
          || request.resource.data.referrer == null
          || (request.resource.data.referrer is string
            && request.resource.data.referrer.size() <= 500));
      allow read: if isAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/referralAffiliates/$(resource.data.affiliateId))
          && get(/databases/$(database)/documents/referralAffiliates/$(resource.data.affiliateId)).data.linkedUserId
            == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /config/admins {
      allow read: if isSignedIn();
      // Bootstrap: first signed-in user can create allowlist with only their email.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/config/admins)
        && request.resource.data.keys().hasAll(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() == 1
        && request.auth.token.email is string
        && request.auth.token.email.lower() in request.resource.data.emails;
      allow update, delete: if isAdmin();
    }

    match /safetyEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /usage/{userId}/periods/{periodId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Product analytics: signed-in clients may append; only admins may read.
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.createdAt is string
        && (
          request.resource.data.userId == null
          || request.resource.data.userId == request.auth.uid
        );
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Public ranking identity (chat counts). Owners sync their own row.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'displayName',
          'photoURL',
          'chatCount',
          'isAdmin',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.chatCount is int
        && request.resource.data.chatCount >= 0
        && request.resource.data.isAdmin is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // PepGuide Pro member forum
    match /forumPosts/{postId} {
      allow read: if canUseProCommunity();

      allow create: if canUseProCommunity()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title',
          'body',
          'authorId',
          'authorDisplayName',
          'authorIsAdmin',
          'createdAt',
          'updatedAt',
          'replyCount',
          'searchText',
          'pinned'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorIsAdmin is bool
        && request.resource.data.replyCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.searchText is string;

      allow update: if canUseProCommunity()
        && (
          // Authors may edit their post content
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'body', 'searchText', 'updatedAt'])
          )
          // Members may bump replyCount/updatedAt when replying
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['replyCount', 'updatedAt'])
          // Pin / unpin (UI shows control to admins only)
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinned', 'updatedAt'])
            && request.resource.data.pinned is bool
          )
        );

      allow delete: if isAdmin()
        || (canUseProCommunity() && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if canUseProCommunity();

        allow create: if canUseProCommunity()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'body',
            'authorId',
            'authorDisplayName',
            'authorIsAdmin',
            'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 8000
          && request.resource.data.authorDisplayName is string
          && request.resource.data.authorIsAdmin is bool
          && request.resource.data.createdAt is string;

        allow update: if false;
        allow delete: if isAdmin()
          || (canUseProCommunity() && resource.data.authorId == request.auth.uid);
      }
    }

    // Vendor reviews forum (signed-in members; listed under PepGuide Pro nav)
    match /vendorReviews/{reviewId} {
      allow read: if canUseProCommunity();

      allow create: if canUseProCommunity()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'partnerId',
          'partnerLabel',
          'rating',
          'title',
          'body',
          'authorId',
          'authorDisplayName',
          'authorIsAdmin',
          'createdAt',
          'updatedAt',
          'replyCount',
          'searchText'
        ])
        && request.resource.data.partnerId is string
        && request.resource.data.partnerId.size() > 0
        && request.resource.data.partnerId.size() <= 80
        && request.resource.data.partnerLabel is string
        && request.resource.data.partnerLabel.size() > 0
        && request.resource.data.partnerLabel.size() <= 120
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorIsAdmin is bool
        && request.resource.data.replyCount == 0
        && request.resource.data.searchText is string;

      allow update: if canUseProCommunity()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replyCount', 'updatedAt']);

      allow delete: if isAdmin()
        || (canUseProCommunity() && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if canUseProCommunity();

        allow create: if canUseProCommunity()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'body',
            'authorId',
            'authorDisplayName',
            'authorIsAdmin',
            'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 8000
          && request.resource.data.authorDisplayName is string
          && request.resource.data.authorIsAdmin is bool
          && request.resource.data.createdAt is string;

        allow update: if false;
        allow delete: if isAdmin()
          || (canUseProCommunity() && resource.data.authorId == request.auth.uid);
      }
    }

    // PepGuide Pro — Ask a Professional (private user ↔ admin consults)
    match /proConsults/{consultId} {
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userDisplayName is string
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.status == 'open'
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount == 1
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.searchText is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      allow update: if isSignedIn()
        && request.resource.data.userId == resource.data.userId
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'lastMessagePreview', 'messageCount']);

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (
            get(/databases/$(database)/documents/proConsults/$(consultId)).data.userId
              == request.auth.uid
            || isAdmin()
          );

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 8000
          && request.resource.data.authorDisplayName is string
          && request.resource.data.authorIsAdmin is bool
          && request.resource.data.createdAt is string
          && (
            get(/databases/$(database)/documents/proConsults/$(consultId)).data.userId
              == request.auth.uid
            || isAdmin()
          );

        allow update: if false;
        allow delete: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );
      }
    }
  }
}
