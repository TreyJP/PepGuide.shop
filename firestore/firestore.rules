rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAllowlistedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email is string
        && request.auth.token.email.lower()
          in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isAdmin() {
      return isAdminClaim() || isAllowlistedAdmin();
    }

    // Pro is enforced in the app UI. Rules allow any signed-in member so
    // env/allowlist/claim admin mismatches don't brick Forum reads.
    function canUseProCommunity() {
      return isSignedIn();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'displayName',
          'email',
          'createdAt',
          'onboardingCompleted',
          'subscriptionTier',
          'accountStatus'
        ])
        && request.resource.data.subscriptionTier == 'free'
        && request.resource.data.accountStatus == 'active';

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'subscriptionTier',
            'accountStatus',
            'chatBlockedUntil',
            'abuseStrikeCount',
            'abuseWindowStartedAt',
            'lastAbuseAt'
          ]);

      allow delete: if isOwner(userId) || isAdmin();

      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          // Temporary: allow client-written assistant messages until
          // Cloud Functions own the AI response write path.
          allow read, write: if isOwner(userId);
        }
      }

      match /savedResearch/{savedItemId} {
        allow read, write: if isOwner(userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /cycleItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /peptides/{peptideId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /affiliatePartners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/admins {
      allow read: if isSignedIn();
      // Bootstrap: first signed-in user can create allowlist with only their email.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/config/admins)
        && request.resource.data.keys().hasAll(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() == 1
        && request.auth.token.email is string
        && request.auth.token.email.lower() in request.resource.data.emails;
      allow update, delete: if isAdmin();
    }

    match /safetyEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /usage/{userId}/periods/{periodId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Product analytics: signed-in clients may append; only admins may read.
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.createdAt is string
        && (
          request.resource.data.userId == null
          || request.resource.data.userId == request.auth.uid
        );
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Public ranking identity (chat counts). Owners sync their own row.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'displayName',
          'photoURL',
          'chatCount',
          'isAdmin',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.chatCount is int
        && request.resource.data.chatCount >= 0
        && request.resource.data.isAdmin is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // PepGuide Pro member forum
    match /forumPosts/{postId} {
      allow read: if canUseProCommunity();

      allow create: if canUseProCommunity()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title',
          'body',
          'authorId',
          'authorDisplayName',
          'authorIsAdmin',
          'createdAt',
          'updatedAt',
          'replyCount',
          'searchText',
          'pinned'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorIsAdmin is bool
        && request.resource.data.replyCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.searchText is string;

      allow update: if canUseProCommunity()
        && (
          // Authors may edit their post content
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'body', 'searchText', 'updatedAt'])
          )
          // Members may bump replyCount/updatedAt when replying
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['replyCount', 'updatedAt'])
          // Pin / unpin (UI shows control to admins only)
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinned', 'updatedAt'])
            && request.resource.data.pinned is bool
          )
        );

      allow delete: if isAdmin()
        || (canUseProCommunity() && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if canUseProCommunity();

        allow create: if canUseProCommunity()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'body',
            'authorId',
            'authorDisplayName',
            'authorIsAdmin',
            'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 8000
          && request.resource.data.authorDisplayName is string
          && request.resource.data.authorIsAdmin is bool
          && request.resource.data.createdAt is string;

        allow update: if false;
        allow delete: if isAdmin()
          || (canUseProCommunity() && resource.data.authorId == request.auth.uid);
      }
    }
  }
}
